msgid "Please enter a correct email and password."
msgstr "Пожалуйста введите верный адрес электронной почты и пароль."

msgctxt "Form field error"
msgid "Incorrect email."
msgstr "Неверный адрес электронной почты."

msgctxt "Success alert message"
msgid "Please follow password reset instructions in the sent email."
msgstr ""
"Для восстановления пароля, пожалуйста следуйте инструкциям которые мы вам "
"выслали на электронную почту."

msgctxt "Form validation error"
msgid "Passwords do not match."
msgstr "Введенные пароли не совпадают."

msgctxt "Form label"
msgid "New password"
msgstr "Новый пароль"

msgctxt "Form field error"
msgid "Please enter new password."
msgstr "Пожалуйста введите новый пароль."

msgctxt "Form label"
msgid "Confirm new password"
msgstr "Пожалуйста подтвердите новый пароль"

msgctxt "Form field error"
msgid "Please enter new password confirmation."
msgstr "Пожалуйста введите подтверждение нового пароля."

msgctxt "Model field"
msgid "username"
msgstr "имя пользователя"

