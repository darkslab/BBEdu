#, python-format
msgctxt "Validation error"
msgid "The password has to be at least %(min_length)d characters."
msgstr "В пароле должно быть не меньше %(min_length)d символов."

#, python-format
msgctxt "Validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one uppercase character."
msgstr ""
"Если пароль меньше %(secure_length)d знаков, добавьте минимум одну заглавную "
"букву."

#, python-format
msgctxt "Validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one lowercase character."
msgstr ""
"Если пароль меньше %(secure_length)d знаков, добавьте минимум одну маленькую "
"букву."

#, python-format
msgctxt "Validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one numeric character."
msgstr ""
"Если пароль меньше %(secure_length)d знаков, добавьте минимум одну цифру."

#, python-format
msgctxt "Validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one symbol character."
msgstr ""
"Если пароль меньше %(secure_length)d знаков, добавьте минимум один символ."

#, python-format
msgctxt "Password validation help text"
msgid ""
"If the password is less than %(secure_length)d characters, it has to be at "
"least %(min_length)d characters and contain uppercase, lowercase, numeric "
"and a symbol character."
msgstr ""
"Если пароль меньше %(secure_length)d знаков, Вы можете создать пароль "
"который должен состоять хотя бы из %(min_length)d знаков в которой есть "
"заглавная буква, маленькая буква, цифра и символ."

#, python-format
msgctxt "Password validation help text"
msgid "The password has to be at least %(min_length)d characters long."
msgstr "В пароле должно быть не меньше %(min_length)d символов."

#, python-format
msgctxt "Validation error"
msgid "The password is too similar to the %(verbose_name)s."
msgstr "Пароль слишком похож на %(verbose_name)s."

msgctxt "Password validation help text"
msgid "The password can't be too similar to your other personal information."
msgstr "Пароль не может быть похож на информацию из Ваших личных данных."

msgctxt "Validation error"
msgid "The password is too common."
msgstr "Это слишком простой пароль."

msgctxt "Password validation help text"
msgid "The password can't be a commonly used password."
msgstr "Пароль не может быть очень простым."

msgctxt "Success alert message"
msgid "Password was reset successfully."
msgstr "Пароль успешно сброшен."

msgctxt "Email subject"
msgid "Password reset"
msgstr "Сброс пароля"

