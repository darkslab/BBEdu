msgstr "сілтеме"

#, python-format
msgctxt "Email body"
msgid ""
"Hello %(name)s,%(line_break)s%(line_break)s We have received a request to "
"reset your password. If you did not request this, then please ignore this "
"email.%(line_break)s%(line_break)s To reset your password please follow this "
"%(link_tag)s.%(line_break)s%(line_break)s Or copy and paste the link below:"
"%(line_break)s %(link_tag_url)s"
msgstr ""
"Сәлеметсізбе %(name)s!%(line_break)s%(line_break)s Біз Сіздің жіберген "
"құпиясөзді өзгерту бойынша сұрауыңызды алдық. Сіз бұл сұрауды жібермеген "
"болсаңыз, бұл хатты елемеуіңізді сұраймыз.%(line_break)s%(line_break)s "
"Құпиясөзді өзгерту үшін келесі сілтемеге өтіңіз %(link_tag)s.%(line_break)s"
"%(line_break)s немесе төмендегі сілтемені көшіріп салыңыз:%(line_break)s "
"%(link_tag_url)s"

#, python-format
msgctxt "Bottom copyright"
msgid "Made with %(heart_icon)s in Kazakhstan. %(copyright_code)s bbTest.kz"
msgstr "Қазақстанда %(heart_icon)s-пен жасалған. %(copyright_code)s bbTest.kz"

