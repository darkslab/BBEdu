msgctxt "Form label"
msgid "Email"
msgstr "Электрондық пошта"

msgctxt "Form field error"
msgid "Please enter email."
msgstr "Электрондық поштаңызды енгізіңіз."

msgctxt "Form label"
msgid "Password"
msgstr "Құпиясөз"

msgctxt "Form field error"
msgid "Please enter password."
msgstr "Құпиясөзді енгізіңіз."

msgctxt "Form validation error"
msgid "Please enter a correct email and password."
msgstr "Дұрыс электрондық поштаңызбен құпиясөзді енгізіңіз."

msgctxt "Form field error"
msgid "Incorrect email."
msgstr "Электрондық поштаңыз дұрыс емес."

msgctxt "Success alert message"
msgid "Please follow password reset instructions in the sent email."
msgstr ""
"Электрондық поштаңызға жіберілген хаттағы нұсқаулық бойынша құпиясөзіңізді "
"өзгертіңіз."

msgctxt "Form validation error"
msgid "Passwords do not match."
msgstr "Құпиясөздер сәйкес келмейді."

msgctxt "Form label"
msgid "New password"
msgstr "Жаңа құпиясөз"

msgctxt "Form field error"
msgid "Please enter new password."
msgstr "Жаңа құпиясөзді енгізіңіз."

msgctxt "Form label"
msgid "Confirm new password"
msgstr "Жаңа құпиясөзді растаңыз"

msgctxt "Form field error"
msgid "Please enter new password confirmation."
msgstr "Жаңа құпиясөздің растауын енгізіңіз."

msgctxt "Model field"
msgid "username"
msgstr "аты-жөні"

msgctxt "Model field"
msgid "email"
msgstr "электрондық пошта"

msgctxt "Model field"
msgid "first name"
msgstr "аты"

msgctxt "Model field"
msgid "last name"
msgstr "тегі"

msgctxt "Model field"
msgid "joined at"
msgstr "тіркелген уақыты"

msgctxt "Model field"
msgid "active?"
msgstr "активті?"

#, python-format
msgctxt "Password validation error"
msgid "The password has to be at least %(min_length)d characters."
msgstr "Құпиясөз кем дегенде %(min_length)d белгіден тұру керек."

#, python-format
msgctxt "Password validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one uppercase character."
msgstr ""
"Құпиясөз %(secure_length)d белгіден аз болса, құрамында кем дегенде бір бас "
"әріп болу керек."

#, python-format
msgctxt "Password validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one lowercase character."
msgstr ""
"Құпиясөз %(secure_length)d белгіден аз болса, құрамында кем дегенде бір кіші "
"әріп болу керек."

#, python-format
msgctxt "Password validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one numeric character."
msgstr ""
"Құпиясөз %(secure_length)d белгіден аз болса, құрамында кем дегенде бір цифр "
"болу керек."

#, python-format
msgctxt "Password validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one symbol character."
msgstr ""
"Құпиясөз %(secure_length)d белгіден аз болса, құрамында кем дегенде бір "
"символ болу керек."

#, python-format
msgctxt "Password validation help text"
msgid ""
"If the password is less than %(secure_length)d characters, it has to be at "
"least %(min_length)d characters and contain uppercase, lowercase, numeric "
"and a symbol character."
msgstr ""
"Құпиясөз %(secure_length)d белгіден аз болса, құпиясөз құрамында бас және "
"кіші әріпі мен бір символы бар кем дегенде %(min_length)d белгіден тұратын "
"болу керек."

#, python-format
msgctxt "Password validation error"
msgid "The password is too similar to the %(verbose_name)s."
msgstr "Құпиясөз сіздің жеке мәліметтеріңізге тым ұқсас: %(verbose_name)s."

msgctxt "Password validation help text"
msgid "The password can't be too similar to your other personal information."
msgstr "Құпиясөз сіздің жеке мәліметтеріңізге ұқсас бола алмайды."

msgctxt "Password validation error"
msgid "The password is too common."
msgstr "Бұл құпиясөз өте оңай. Тағы ойланып көріңіз."

msgctxt "Password validation help text"
msgid "The password can't be a commonly used password."
msgstr "Бұл құпиясөз өте оңай. Тағы ойланып көріңіз."

msgctxt "Success alert message"
msgid "Password was reset successfully."
msgstr "Құпиясөз өзгертілді."

msgctxt "Email subject"
msgid "Password reset"
msgstr "Құпиясөзді өзгерту"

msgctxt "Form label"
msgid "Confirm password"
msgstr "Құпиясөзді растау"

msgctxt "Form field error"
msgid "Please enter password confirmation."
msgstr "Құпиясөздің растауын енгізіңіз."

msgctxt "Form field error"
msgid "Please enter first name."
msgstr "Атыңызды енгізіңіз."

msgctxt "Form field error"
msgid "First name is too long."
msgstr "Атыңыздың ұзындығын тексеріңіз. Қысқа нұсқасын беріңіз."

msgctxt "Form field error"
msgid "Please enter last name."
msgstr "Тегіңізді енгізіңіз."

msgctxt "Form field error"
msgid "Last name is too long."
msgstr "Тегіңіздің ұзындығын тексеріңіз. Қысқа нұсқасын беріңіз."

msgctxt "Form field error"
msgid "Email is too long."
msgstr "Электрондық поштаңыздың ұзындығын тексеріңіз."

msgctxt "Form field error"
msgid "This email is already taken."
msgstr "Бұл электрондық пошта тіркелген."

msgctxt "Form label"
msgid "Old password"
msgstr "Ескі құпиясөз"

msgctxt "Form field error"
msgid "Please enter old password."
msgstr "Ескі құпиясөзді енгізіңіз."

msgctxt "Form validation error"
msgid "Incorrect old password."
msgstr "Ескі құпиясөз дұрыс емес."

msgctxt "Model field"
msgid "from email"
msgstr "электрондық поштадан"

msgctxt "Model field"
msgid "recipients"
msgstr "қабылдаушылар"

