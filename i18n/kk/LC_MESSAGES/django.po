#, python-format
msgctxt "Validation error"
msgid "The password has to be at least %(min_length)d characters."
msgstr "Құпиясөз кем дегенде %(min_length)d белгіден тұру керек."

#, python-format
msgctxt "Validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one uppercase character."
msgstr ""
"Құпиясөз %(secure_length)d белгіден аз болса, құрамында кем дегенде бір бас "
"әріп болу керек."

#, python-format
msgctxt "Validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one lowercase character."
msgstr ""
"Құпиясөз %(secure_length)d белгіден аз болса, құрамында кем дегенде бір кіші "
"әріп болу керек."

#, python-format
msgctxt "Validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one numeric character."
msgstr ""
"Құпиясөз %(secure_length)d белгіден аз болса, құрамында кем дегенде бір цифр "
"болу керек."

#, python-format
msgctxt "Validation error"
msgid ""
"If the password is less than %(secure_length)d characters, it has to contain "
"at least one symbol character."
msgstr ""
"Құпиясөз %(secure_length)d белгіден аз болса, құрамында кем дегенде бір "
"символ болу керек."

#, python-format
msgctxt "Password validation help text"
msgid ""
"If the password is less than %(secure_length)d characters, it has to be at "
"least %(min_length)d characters and contain uppercase, lowercase, numeric "
"and a symbol character."
msgstr ""
"Құпиясөз %(secure_length)d белгіден аз болса, құпиясөз құрамында бас және "
"кіші әріпі мен бір символы бар кем дегенде %(min_length)d белгіден тұратын "
"болу керек."

#, python-format
msgctxt "Password validation help text"
msgid "The password has to be at least %(min_length)d characters long."
msgstr "Құпиясөз кем дегенде %(min_length)d белгіден тұру керек."

#, python-format
msgctxt "Validation error"
msgid "The password is too similar to the %(verbose_name)s."
msgstr "Құпиясөз сіздің жеке мәліметтеріңізге тым ұқсас: %(verbose_name)s."

msgctxt "Password validation help text"
msgid "The password can't be too similar to your other personal information."
msgstr "Құпиясөз сіздің жеке мәліметтеріңізге ұқсас бола алмайды."

msgctxt "Validation error"
msgid "The password is too common."
msgstr "Бұл құпиясөз өте оңай. Тағы ойланып көріңіз."

